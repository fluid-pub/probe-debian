# --- Option A: already enrolled (credentials.yaml written on a previous boot) ---
# auth.organization_uuid, auth.token and controlplane.base_url load from
# /etc/fluid-probe/credentials.yaml by default, or set them in config.yml / env.

# --- Option B: first boot enrollment (systemd EnvironmentFile = enrollment.env) ---
# FLUID_ENROLLMENT_TOKEN=replace_with_provisioned_enrollment_secret
# FLUID_CONTROLPLANE_HTTP_BASE=https://dev.fluid.pub

# The probe calls POST /api/v1/enrollment/enroll (principal=probe, agent_type=debian),
# then writes /etc/fluid-probe/credentials.yaml and removes enrollment.env.
